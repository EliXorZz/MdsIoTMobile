      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rabbitmq_detailed_queue_consumers{queue=\"telemetry\"}", "legendFormat": "workers", "refId": "A" }]
    },

    {
      "type": "stat", "id": 12, "title": "Consommateur file datalake",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 22, "w": 6, "h": 3 },
      "fieldConfig": {
        "defaults": {
