{
  "annotations": { "list": [] },
  "description": "Observabilité bout-en-bout Mosquitto → RabbitMQ → Postgres/MongoDB : bilan « rien perdu », lag, erreurs PostgreSQL, redémarrages subscriber.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    { "type": "row", "id": 100, "title": "BILAN — rien ne se perd ?", "collapsed": false, "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 } },

    {
      "type": "stat", "id": 1, "title": "Messages reçus (télémétrie)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "value_and_name", "colorMode": "background", "graphMode": "area" },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "sum(max_over_time({service=\"subscriber\"} | json | eventType=`telemetry.received` | unwrap count [$__range])) - sum(min_over_time({service=\"subscriber\"} | json | eventType=`telemetry.received` | unwrap count [$__range]))",
        "legendFormat": "sur la plage",
        "refId": "A"
      }]
    },

    {
      "type": "stat", "id": 2, "title": "En attente — file telemetry",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10000 }, { "color": "red", "value": 50000 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "value_and_name", "colorMode": "background", "graphMode": "area" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "rabbitmq_detailed_queue_messages{queue=\"telemetry\"}",
        "legendFormat": "messages en file",
        "refId": "A"
      }]
    },

    {
      "type": "stat", "id": 3, "title": "En base — lignes télémetry (Postgres, cumul)",
      "datasource": { "type": "postgres", "uid": "postgres" },
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "value_and_name", "colorMode": "background", "graphMode": "area" },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "postgres" },
        "rawSql": "SELECT count(*) AS messages_consolides FROM telemetry",
        "format": "table",
        "refId": "A"
      }]
    },

    {
      "type": "stat", "id": 4, "title": "Rejetés",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "value_and_name", "colorMode": "background", "graphMode": "area" },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "sum(count_over_time({service=~\"subscriber|worker|datalake-worker\"} | json | eventType=~`telemetry_consumer.invalid_payload|state.rejected|availability.rejected|command_result.rejected` [$__range]))",
        "legendFormat": "invalid/rejected",
        "refId": "A"
      }]
    },

    {
      "type": "stat", "id": 5, "title": "Perdus (broker MQTT)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "value_and_name", "colorMode": "background", "graphMode": "area" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum(increase(broker_publish_messages_dropped[$__range]))",
        "legendFormat": "drops broker",
        "refId": "A"
      }]
    },

    {
      "type": "stat", "id": 6, "title": "Coupures subscriber",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "value_and_name", "colorMode": "background", "graphMode": "area" },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "sum(count_over_time({service=\"subscriber\"} | json | eventType=~`mqtt.connection_lost|mqtt.connection_failed` [$__range]))",
        "legendFormat": "déconnexions",
        "refId": "A"
      }]
    },

    { "type": "row", "id": 101, "title": "Débits & lag", "collapsed": false, "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 } },

    {
      "type": "timeseries", "id": 7, "title": "Débit pipeline — Mosquitto → Subscriber → Worker (msgs/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["lastNotNull", "mean"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(broker_publish_messages_received[1m])", "legendFormat": "Mosquitto — publish reçus", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(rabbitmq_queue_messages_published_total[1m])", "legendFormat": "RabbitMQ — enqueued (toutes files)", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(rabbitmq_queue_messages_acked_total[1m])", "legendFormat": "RabbitMQ — ackés", "refId": "C" },
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(rate({service=\"subscriber\"} | json | eventType=`telemetry.received` | unwrap count [1m]))", "legendFormat": "Subscriber — reçus", "refId": "D" },
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(rate({service=\"worker\"} | json | eventType=`batch_consumer.throughput` | unwrap count [1m]))", "legendFormat": "Worker telemetry — consolidés", "refId": "E" },
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(rate({service=\"datalake-worker\"} | json | eventType=`batch_consumer.throughput` | unwrap count [1m]))", "legendFormat": "Worker datalake — traités", "refId": "F" }
      ]
    },

    {
      "type": "timeseries", "id": 8, "title": "LAG temps — enqueue → consolidation (ms)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 10000 }] }
        },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "max(max_over_time({service=\"worker\"} | json | eventType=`telemetry_consumer.lag` | unwrap maxLagMs [1m]))", "legendFormat": "lag max", "refId": "A" },
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "avg(avg_over_time({service=\"worker\"} | json | eventType=`telemetry_consumer.lag` | unwrap avgLagMs [1m]))", "legendFormat": "lag moyen", "refId": "B" }
      ]
    },

    {
      "type": "timeseries", "id": 9, "title": "File telemetry — taille / backlog / en traitement",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 }
        },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rabbitmq_detailed_queue_messages{queue=\"telemetry\"}", "legendFormat": "taille totale", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rabbitmq_detailed_queue_messages_ready{queue=\"telemetry\"}", "legendFormat": "backlog prêt", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rabbitmq_detailed_queue_messages_unacked{queue=\"telemetry\"}", "legendFormat": "en traitement (batch)", "refId": "C" }
      ]
    },

    { "type": "row", "id": 102, "title": "Files & consommation", "collapsed": false, "gridPos": { "x": 0, "y": 21, "w": 24, "h": 1 } },

