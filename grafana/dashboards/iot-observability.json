          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "value_and_name", "colorMode": "background", "graphMode": "area" },
      "targets": [{ "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({service=~\"worker|datalake-worker\"} | json | eventType=`batch_consumer.batch_nacked` [$__range]))", "legendFormat": "batchs nackés", "refId": "A" }]
    },

    {
      "type": "stat", "id": 19, "title": "Redémarrages subscriber",
      "datasource": { "type": "loki", "uid": "loki" },
