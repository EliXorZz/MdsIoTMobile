      "targets": [{ "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({service=\"subscriber\"} | json | eventType=`mqtt.subscribed` [$__range]))", "legendFormat": "abonnements", "refId": "A" }]
