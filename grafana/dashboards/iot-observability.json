        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rabbitmq_detailed_queue_messages{queue=\"datalake\"}", "legendFormat": "taille totale", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rabbitmq_detailed_queue_messages_ready{queue=\"datalake\"}", "legendFormat": "backlog prêt", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rabbitmq_detailed_queue_messages_unacked{queue=\"datalake\"}", "legendFormat": "en traitement (batch)", "refId": "C" }
      ]
    },

    {
      "type": "stat", "id": 11, "title": "Consommateur file telemetry",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 22, "w": 6, "h": 3 },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
