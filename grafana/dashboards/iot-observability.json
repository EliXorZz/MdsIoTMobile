        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "value_and_name", "colorMode": "background", "graphMode": "area" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rabbitmq_detailed_queue_consumers{queue=\"datalake\"}", "legendFormat": "workers", "refId": "A" }]
    },

    {
      "type": "timeseries", "id": 13, "title": "En attente — toutes files RabbitMQ (taille & backlog)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 25, "w": 12, "h": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 }
        },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rabbitmq_detailed_queue_messages{queue=~\"telemetry|datalake\"}", "legendFormat": "{{queue}} — en attente", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rabbitmq_detailed_queue_messages_ready{queue=~\"telemetry|datalake\"}", "legendFormat": "{{queue}} — backlog prêt", "refId": "B" }
      ]
    },

    { "type": "row", "id": 103, "title": "Pertes & rejets", "collapsed": false, "gridPos": { "x": 0, "y": 32, "w": 24, "h": 1 } },

    {
      "type": "timeseries", "id": 14, "title": "Pertes — drops broker & coupures subscriber",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 33, "w": 12, "h": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(broker_publish_messages_dropped[1m])", "legendFormat": "drops broker (msgs/s)", "refId": "A" },
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({service=\"subscriber\"} | json | eventType=`mqtt.connection_lost` [1m]))", "legendFormat": "coupures subscriber", "refId": "B" }
      ]
    },

    {
      "type": "logs", "id": 15, "title": "Pertes MQTT — déconnexions & reconnexions",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 12, "y": 33, "w": 12, "h": 7 },
      "options": { "dedupStrategy": "none", "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending" },
      "targets": [{ "datasource": { "type": "loki", "uid": "loki" }, "expr": "{service=\"subscriber\"} | json | eventType=~`mqtt.connection_lost|mqtt.connection_failed|mqtt.reconnect_attempt`", "refId": "A" }]
    },

    {
      "type": "timeseries", "id": 16, "title": "Rejets & doublons par type",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 40, "w": 12, "h": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "sum by (eventType) (count_over_time({service=~\"subscriber|worker|datalake-worker\"} | json | eventType=~`telemetry_consumer.invalid_payload|telemetry_consumer.duplicates|state.rejected|availability.rejected|command_result.rejected` [1m]))",
        "legendFormat": "{{eventType}}",
        "refId": "A"
      }]
    },

    {
      "type": "logs", "id": 17, "title": "Détail des rejets & doublons",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 12, "y": 40, "w": 12, "h": 7 },
      "options": { "dedupStrategy": "none", "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending" },
      "targets": [{ "datasource": { "type": "loki", "uid": "loki" }, "expr": "{service=~\"subscriber|worker|datalake-worker\"} | json | eventType=~`telemetry_consumer.invalid_payload|telemetry_consumer.duplicates|state.rejected|availability.rejected|command_result.rejected`", "refId": "A" }]
    },

    { "type": "row", "id": 104, "title": "Erreurs PostgreSQL & redémarrages subscriber", "collapsed": false, "gridPos": { "x": 0, "y": 47, "w": 24, "h": 1 } },

    {
      "type": "stat", "id": 18, "title": "Batchs échoués (nack)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 48, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0,
