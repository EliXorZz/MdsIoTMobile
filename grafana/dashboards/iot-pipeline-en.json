    {
      "type": "timeseries",
      "id": 12,
      "title": "Telemetry Rate per Device (TimescaleDB)",
      "description": "Messages stored per device over time \u2014 confirms data isolation between sensors and no cross-contamination",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "spanNulls": false
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "sum",
            "mean"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "format": "time_series",
          "rawSql": "SELECT\n  $__timeGroupAlias(observed_at, $__interval, 0),\n  device_id AS metric,\n  COUNT(*) AS \"messages\"\nFROM telemetry\nWHERE $__timeFilter(observed_at)\nGROUP BY 1, device_id\nORDER BY 1",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "id": 13,
      "title": "Sensor Freshness \u2014 Silent Sensor Detection",
      "description": "Current staleness of each device. fresh = <30s, stale = <2m, silent = offline or stopped.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "fresh": {
                        "color": "green",
                        "index": 0,
                        "text": "fresh"
                      },
                      "stale": {
                        "color": "yellow",
                        "index": 1,
                        "text": "stale"
                      },
                      "silent": {
                        "color": "red",
                        "index": 2,
                        "text": "silent"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Age (s)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 30
                    },
                    {
                      "color": "red",
                      "value": 120
                    }
                  ]
                }
              },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last Seen"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "Age (s)"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "format": "table",
          "rawSql": "SELECT\n  device_id AS \"Device ID\",\n  MAX(observed_at) AS \"Last Seen\",\n  ROUND(EXTRACT(EPOCH FROM (NOW() - MAX(observed_at))))::integer AS \"Age (s)\",\n  COUNT(*) AS \"Total Stored\",\n  CASE\n    WHEN NOW() - MAX(observed_at) < INTERVAL '30 seconds' THEN 'fresh'\n    WHEN NOW() - MAX(observed_at) < INTERVAL '2 minutes' THEN 'stale'\n    ELSE 'silent'\n  END AS \"Status\"\nFROM telemetry\nGROUP BY device_id\nORDER BY \"Age (s)\" ASC",
          "refId": "A"
        }
      ]
    },
