      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(app_telemetry_mqtt_received[$__rate_interval])",
          "legendFormat": "Subscriber",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(app_telemetry_stored[$__rate_interval]) + on(instance,job) increase(app_telemetry_duplicates[$__rate_interval]) + on(instance,job) sum without(reason)(increase(app_telemetry_rejected[$__rate_interval]))",
          "legendFormat": "Worker processed",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
