          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(app_datalake_stored[$__rate_interval])",
          "legendFormat": "MongoDB",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by (instance,job) (label_replace(increase(app_telemetry_mqtt_received[$__rate_interval]),\"m\",\"a\",\"\",\"\") or label_replace(increase(app_telemetry_stored[$__rate_interval]),\"m\",\"b\",\"\",\"\") or label_replace(increase(app_datalake_stored[$__rate_interval]),\"m\",\"c\",\"\",\"\"))",
          "legendFormat": "Min",
          "refId": "E"
        }
      ]
